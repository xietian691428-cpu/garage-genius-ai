# Copy to .env.e2e.local (never commit) or export before running Playwright.
# Use a dedicated Supabase test user — do not use production customer accounts.

E2E_EMAIL=e2e-tester@example.com
E2E_PASSWORD=replace-with-strong-password

# Optional overrides
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# E2E_MOCK_AI=1          # default: mock DeepSeek chat + shop-report generate
# E2E_MOCK_AI=0          # hit real APIs (needs tokens + migrations applied)
# PLAYWRIGHT_SKIP_WEBSERVER=1  # when server already running
