/**
 * Production CoachScenarioPlayer — EN (US/EU).
 * Load only content/coach-scenarios/*_production.json
 *
 * Integration: see content/coach-scenarios/INTEGRATION.md
 */
import React, { useMemo, useState } from "react";
import { Modal, Pressable, SafeAreaView, Text, View } from "react-native";
import type { CoachScenario } from "../../lib/types/coach-scenario";
import {
  COACH_FIND_SHOP_LABEL_EN,
  COACH_RISK_CHECKBOX_EN,
  COACH_SAFETY_DISCLAIMER_EN,
  COACH_SAFETY_DISCLAIMER_EN_FULL,
} from "../../lib/types/coach-scenario";

type Vehicle = {
  year?: number;
  make?: string;
  model?: string;
  mileage?: number;
  powertrain?: string;
};

type Props = {
  scenario: CoachScenario;
  vehicle: Vehicle;
  userName?: string;
  onClose?: () => void;
  openChat?: (prompt: string) => void;
  openParts?: (payload?: string) => void;
  /** Maps / shop finder — used by risk cancel + book_shop */
  openShop?: () => void;
  logMaintenance?: (category: string) => void;
  takePhoto?: () => void;
  emitFocus?: (part: string, action: string) => void;
};

function injectTokens(tpl: string, ctx: Record<string, string | number>) {
  return tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => String(ctx[k] ?? ""));
}

function resolveNextServiceMiles(scenario: CoachScenario, mileage: number) {
  const matched =
    scenario.adaptive_rules.find((r) => typeof r.interval_miles === "number")?.interval_miles ??
    scenario.completion.next_check_miles_default ??
    6000;
  return mileage + matched;
}

export function CoachScenarioPlayer({
  scenario,
  vehicle,
  userName,
  onClose,
  openChat,
  openParts,
  openShop,
  logMaintenance,
  takePhoto,
  emitFocus,
}: Props) {
  const [stepId, setStepId] = useState(scenario.entry_step_id || scenario.steps[0].id);
  const [flags, setFlags] = useState<Record<string, unknown>>({});
  const [riskOpen, setRiskOpen] = useState(false);
  const [riskChecked, setRiskChecked] = useState(false);
  const [pendingBtn, setPendingBtn] = useState<any>(null);

  const step = useMemo(() => {
    const raw = scenario.steps.find((s) => s.id === stepId)!;
    // applyVariants(raw, vehicle) in real app
    return raw;
  }, [scenario, stepId]);

  const asset = scenario.visual_assets.find((a) => a.key === step.visual_asset_key);
  const mileage = Number(vehicle.mileage || 0);
  const nextService = resolveNextServiceMiles(scenario, mileage);
  const ctx = {
    year: vehicle.year ?? "",
    make: vehicle.make ?? "",
    model: vehicle.model ?? "",
    mileage,
    name: userName ?? "",
    next_service: nextService,
    next_service_miles: nextService, // alias
  };

  React.useEffect(() => {
    emitFocus?.(step.focus_part || scenario.focus_part || "engine", step.id);
  }, [step.id]);

  const maxBtns = scenario.ux_rules?.max_action_buttons ?? 2;
  const buttons = (step.action_buttons || []).slice(0, maxBtns);
  const percent = step.progress?.percent ?? Math.round((step.progress?.fraction || 0) * 100);

  function runAction(btn: any) {
    if (btn.set_flags) setFlags((f) => ({ ...f, ...btn.set_flags }));
    switch (btn.action) {
      case "goto":
      case "skip_to":
        setStepId(btn.next_step_id || btn.payload);
        break;
      case "book_shop":
        openShop?.();
        break;
      case "open_chat":
        openChat?.(btn.payload || "");
        break;
      case "open_parts":
        openParts?.(btn.payload);
        break;
      case "take_photo":
        takePhoto?.();
        break;
      case "log_maintenance":
        logMaintenance?.(btn.payload);
        break;
      case "mark_done":
        onClose?.();
        break;
      default:
        break;
    }
  }

  function onPress(btn: any) {
    const needsRisk =
      scenario.ux_rules?.enforce_risk_confirm_modal &&
      step.risk_confirm?.required &&
      (btn.style === "primary" || btn.action === "goto") &&
      !flags[`risk_ack_${step.id}`];

    if (needsRisk) {
      setPendingBtn(btn);
      setRiskChecked(false);
      setRiskOpen(true);
      return;
    }
    runAction(btn);
  }

  function confirmRisk() {
    if (!riskChecked || !pendingBtn) return;
    setFlags((f) => ({ ...f, [`risk_ack_${step.id}`]: true }));
    setRiskOpen(false);
    const btn = pendingBtn;
    setPendingBtn(null);
    runAction(btn);
  }

  function cancelRiskToShop() {
    setRiskOpen(false);
    setPendingBtn(null);
    openShop?.();
  }

  return (
    <SafeAreaView>
      {scenario.ux_rules?.show_progress_bar && (
        <View>
          <Text>{step.progress?.label || `${percent}% complete`}</Text>
          {/* <ProgressBar fraction={percent / 100} /> */}
        </View>
      )}

      {/* Visual-first hero — autoplay muted GIF/video */}
      {/* <CoachMedia type={step.visual_type} src={asset?.src} poster={asset?.poster} /> */}

      <Text>{step.title}</Text>
      {!!step.coach_encourage && <Text>{step.coach_encourage}</Text>}
      {!!step.personalize && <Text>{injectTokens(step.personalize, ctx)}</Text>}
      <Text>{injectTokens(step.description, ctx)}</Text>

      {!!step.trust_nudge && <Text>{step.trust_nudge}</Text>}
      {!!step.safety_warning && <Text>{step.safety_warning}</Text>}

      <View>
        {buttons.map((btn) => (
          <Pressable key={btn.id} onPress={() => onPress(btn)}>
            <Text>{btn.label}</Text>
          </Pressable>
        ))}
      </View>

      {/* Sticky legal footer — every step */}
      <Text>
        {step.safety_disclaimer ||
          scenario.ux_rules?.safety_disclaimer_default ||
          COACH_SAFETY_DISCLAIMER_EN}
      </Text>

      <Modal visible={riskOpen} transparent animationType="fade">
        <View>
          <Text>{step.risk_confirm?.title}</Text>
          <Text>{step.risk_confirm?.body}</Text>
          <Text>
            {step.risk_confirm?.disclaimer ||
              scenario.ux_rules?.safety_disclaimer_modal ||
              COACH_SAFETY_DISCLAIMER_EN_FULL}
          </Text>

          <Pressable onPress={() => setRiskChecked((v) => !v)}>
            <Text>
              {riskChecked ? "[x] " : "[ ] "}
              {step.risk_confirm?.checkbox_label ||
                scenario.ux_rules?.risk_checkbox_label_default ||
                COACH_RISK_CHECKBOX_EN}
            </Text>
          </Pressable>

          <Pressable onPress={confirmRisk} disabled={!riskChecked}>
            <Text>{step.risk_confirm?.confirm_label || "I understand — continue"}</Text>
          </Pressable>

          {/* Cancel ALWAYS → nearby shop */}
          <Pressable onPress={cancelRiskToShop}>
            <Text>
              {step.risk_confirm?.cancel_label ||
                scenario.ux_rules?.risk_cancel_label_default ||
                COACH_FIND_SHOP_LABEL_EN}
            </Text>
          </Pressable>
        </View>
      </Modal>
    </SafeAreaView>
  );
}

/*
 * Usage:

import oil from "./maintenance_oil_production.json";
import { CoachScenarioPlayer } from "./CoachScenarioPlayer";

<CoachScenarioPlayer
  scenario={oil as CoachScenario}
  vehicle={{ year: 2021, make: "Toyota", model: "RAV4", mileage: 72000 }}
  userName="Alex"
  openChat={(p) => navigation.navigate("Chat", { prefill: p })}
  openParts={(p) => navigation.navigate("Parts", { q: p })}
  openShop={() => navigation.navigate("ShopFinder", { near: "me" })}
  logMaintenance={(c) => api.maintenance.create({ category: c })}
  takePhoto={() => navigation.navigate("Camera")}
  emitFocus={(part, action) => focusBus.emit({ part, action })}
/>

 */
