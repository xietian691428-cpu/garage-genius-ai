/**
 * Final CoachScenarioPlayer — disclaimer footer + risk-confirm modal.
 * Prefer content/coach-scenarios/*_final.json
 */
import React, { useMemo, useState } from "react";
import { Modal, Pressable, SafeAreaView, Text, View } from "react-native";

const DEFAULT_RISK_CHECKBOX = "我已阅读并理解风险";

type Props = {
  scenario: any; // CoachScenario from *_final.json
  vehicle: { year?: number; make?: string; model?: string; mileage?: number; powertrain?: string };
  userName?: string;
  onClose?: () => void;
  openChat?: (prompt: string) => void;
  openParts?: (payload?: string) => void;
  openShop?: () => void;
  logMaintenance?: (category: string) => void;
  takePhoto?: () => void;
};

function injectTokens(tpl: string, ctx: Record<string, string | number>) {
  return tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => String(ctx[k] ?? ""));
}

export function CoachScenarioPlayer({
  scenario,
  vehicle,
  userName,
  onClose,
  openChat,
  openParts,
  openShop,
  logMaintenance,
  takePhoto,
}: Props) {
  const [stepId, setStepId] = useState(scenario.entry_step_id || scenario.steps[0].id);
  const [flags, setFlags] = useState<Record<string, unknown>>({});
  const [riskOpen, setRiskOpen] = useState(false);
  const [riskChecked, setRiskChecked] = useState(false);
  const [pendingBtn, setPendingBtn] = useState<any>(null);

  const step = useMemo(() => {
    const raw = scenario.steps.find((s: any) => s.id === stepId);
    // applyVariants(raw, vehicle) in real app
    return raw;
  }, [scenario, stepId]);

  const asset = scenario.visual_assets.find((a: any) => a.key === step.visual_asset_key);
  const nextService =
    scenario.adaptive_rules?.find((r: any) => r.interval_miles)?.interval_miles ??
    scenario.completion?.next_check_miles_default ??
    6000;
  const ctx = {
    year: vehicle.year ?? "",
    make: vehicle.make ?? "",
    model: vehicle.model ?? "",
    mileage: vehicle.mileage ?? "",
    name: userName ?? "",
    next_service_miles: Number(vehicle.mileage || 0) + Number(nextService),
  };

  const maxBtns = scenario.ux_rules?.max_action_buttons ?? 2;
  const buttons = (step.action_buttons || []).slice(0, maxBtns);

  function runAction(btn: any) {
    if (btn.set_flags) setFlags((f) => ({ ...f, ...btn.set_flags }));
    switch (btn.action) {
      case "goto":
      case "skip_to":
        setStepId(btn.next_step_id || btn.payload);
        break;
      case "book_shop":
        openShop?.();
        break;
      case "open_chat":
        openChat?.(btn.payload || "");
        break;
      case "open_parts":
        openParts?.(btn.payload);
        break;
      case "take_photo":
        takePhoto?.();
        break;
      case "log_maintenance":
        logMaintenance?.(btn.payload);
        break;
      case "mark_done":
        onClose?.();
        break;
      default:
        break;
    }
  }

  function onPress(btn: any) {
    // Block primary continue on high-risk until modal ack (once per step entry)
    const needsRisk =
      scenario.ux_rules?.enforce_risk_confirm_modal &&
      step.risk_confirm?.required &&
      (btn.style === "primary" || btn.action === "goto") &&
      !flags[`risk_ack_${step.id}`];

    if (needsRisk) {
      setPendingBtn(btn);
      setRiskChecked(false);
      setRiskOpen(true);
      return;
    }
    runAction(btn);
  }

  function confirmRisk() {
    if (!riskChecked || !pendingBtn) return;
    setFlags((f) => ({ ...f, [`risk_ack_${step.id}`]: true }));
    setRiskOpen(false);
    const btn = pendingBtn;
    setPendingBtn(null);
    runAction(btn);
  }

  return (
    <SafeAreaView>
      {scenario.ux_rules?.show_progress_bar && (
        <View>
          <Text>{step.progress?.label}</Text>
          {/* ProgressBar fraction={step.progress?.fraction} */}
        </View>
      )}

      {/* Visual-first: GIF/video autoplay */}
      {/* <CoachMedia type={step.visual_type} src={asset?.src} poster={asset?.poster} /> */}

      <Text>{step.title}</Text>
      {!!step.coach_encourage && <Text>{step.coach_encourage}</Text>}
      {!!step.personalize && <Text>{injectTokens(step.personalize, ctx)}</Text>}
      <Text>{injectTokens(step.description, ctx)}</Text>

      {!!step.trust_nudge && <Text>{step.trust_nudge}</Text>}
      {!!step.safety_warning && <Text>{step.safety_warning}</Text>}

      {buttons.map((btn: any) => (
        <Pressable key={btn.id} onPress={() => onPress(btn)}>
          <Text>{btn.label}</Text>
        </Pressable>
      ))}

      {step.is_operational && step.safety_disclaimer ? (
        <Text>{step.safety_disclaimer}</Text>
      ) : null}

      <Modal visible={riskOpen} transparent animationType="fade">
        <View>
          <Text>{step.risk_confirm?.title}</Text>
          <Text>{step.risk_confirm?.body}</Text>
          <Text>{step.safety_disclaimer || scenario.ux_rules?.safety_disclaimer_default}</Text>
          <Pressable onPress={() => setRiskChecked((v) => !v)}>
            <Text>
              {riskChecked ? "[x] " : "[ ] "}
              {step.risk_confirm?.checkbox_label || DEFAULT_RISK_CHECKBOX}
            </Text>
          </Pressable>
          <Pressable onPress={confirmRisk} disabled={!riskChecked}>
            <Text>{step.risk_confirm?.confirm_label || "Continue"}</Text>
          </Pressable>
          <Pressable
            onPress={() => {
              setRiskOpen(false);
              if (step.risk_confirm?.cancel_action === "book_shop") openShop?.();
            }}
          >
            <Text>{step.risk_confirm?.cancel_label || "Back"}</Text>
          </Pressable>
        </View>
      </Modal>
    </SafeAreaView>
  );
}

// Usage:
// <CoachScenarioPlayer
//   scenario={require('../content/coach-scenarios/maintenance_oil_final.json')}
//   vehicle={{ year: 2021, make: 'Toyota', model: 'RAV4', mileage: 72000 }}
//   userName="Alex"
//   openChat={(p) => navigation.navigate('Chat', { prefill: p })}
//   openShop={() => navigation.navigate('ShopFinder')}
//   logMaintenance={(c) => api.log({ category: c })}
// />
