# Copy to .env.local (local) or set in Vercel / host (production).
# Never commit .env.local or live secrets.

# =============================================================================
# REQUIRED — production Web launch
# =============================================================================

# Public site URL (no trailing slash). Used for Stripe success/cancel + OAuth.
NEXT_PUBLIC_APP_URL=https://garagegenius.cloud

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — seed, admin stats, playbook quota, Stripe sync
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (chat + photo vision) ---
# Chat / coaching text (lib/deepseek.ts).
DEEPSEEK_API_KEY=
# Photo / OBD / receipt vision — Kimi (Moonshot). Prefer KIMI_API_KEY.
KIMI_API_KEY=
# MOONSHOT_API_KEY=   # alias accepted if KIMI_API_KEY unset
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1   # alias if KIMI_BASE_URL unset
# KIMI_VISION_MODEL=kimi-k3
# KIMI_VISION_ENABLED=true   # default on when a key exists; set 0 to disable
# KIMI_VISION_TIMEOUT_MS=28000
# Optional alternate / embeddings providers:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- Stripe (subscriptions + portal + webhook) ---
# Use sk_live_ / pk_live_ / price_… live IDs in production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_HEAVY_MONTHLY=
STRIPE_PRICE_HEAVY_YEARLY=

# --- Apple IAP (StoreKit 2 — iOS Capacitor shell) ---
# App Store Connect → App → App Information → Apple ID (numeric)
APPLE_BUNDLE_ID=com.garagegenius.ai
# APPLE_APP_APPLE_ID=
# Optional product id overrides (defaults: com.garagegenius.ai.pro.monthly etc.)
# APPLE_IAP_PRO_MONTHLY=
# APPLE_IAP_PRO_YEARLY=
# APPLE_IAP_HEAVY_MONTHLY=
# APPLE_IAP_HEAVY_YEARLY=
# ASN V2 URL: https://<host>/api/apple/notifications

# --- Admin dashboards (/admin/login → token-usage, revenue, refunds) ---
ADMIN_EMAIL=you@example.com
# Prefer base64 so $ / # in passwords do not break .env parsing:
ADMIN_PASSWORD_B64=
# ADMIN_PASSWORD=
# Min 12 characters required. Recommended: long random password + separate cookie HMAC:
# ADMIN_SESSION_SECRET=

# Email verification gate (default ON). Set to 0 only for local/staging escapes.
# REQUIRE_EMAIL_VERIFICATION=1

# =============================================================================
# MUST STAY OFF in production
# =============================================================================
# Bypasses token billing and disables Stripe APIs (503). Never set on prod.
# Hard-blocked when VERCEL_ENV=production even if mis-set.
# NEXT_PUBLIC_QA_UNLOCK=
# QA_UNLOCK=

# Optional OAuth buttons (hidden unless enabled after Supabase providers are live)
# NEXT_PUBLIC_AUTH_APPLE=1
# NEXT_PUBLIC_AUTH_GOOGLE=1

# =============================================================================
# OPTIONAL — reminders / push / affiliates
# =============================================================================
# CRON_SECRET=
# RESEND_API_KEY=
# REMINDER_FROM_EMAIL=reminders@garagegenius.cloud

# Web Push (VAPID) — npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@garagegenius.cloud

# Amazon — keyword search only for now (no product deep links).
# Tag is kept as a placeholder; not applied unless AMAZON_AFFILIATE_DEEP_LINKS=1 later.
# AMAZON_ASSOCIATES_TAG=
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
# AMAZON_AFFILIATE_DEEP_LINKS=0

# Anti-abuse overrides (defaults in lib/ai-abuse.ts)
# AI_MAX_REQUESTS_PER_HOUR=20
# AI_MAX_REQUESTS_PER_DAY=60

# AI cost hard cap (USD budget + monthly vision). Default ON when unset.
# Production must stay ON. Set 0 only for staging/incidents.
# AI_COST_HARD_CAP=1
# Optional Kimi price overrides (USD). Defaults: $2.50 / $10 per 1M + $0.012/call.
# KIMI_COST_INPUT_PER_1M=2.5
# KIMI_COST_OUTPUT_PER_1M=10
# KIMI_COST_PER_CALL_FLOOR=0.012
# Optional DeepSeek price overrides (already used by token cost estimates):
# TOKEN_COST_PROMPT_PER_1M=0.14
# TOKEN_COST_COMPLETION_PER_1M=0.28

# Chat intent-drift debug (shouldReset / reason / summary). Off in production.
# NEXT_PUBLIC_CHAT_DRIFT_DEBUG=1

# =============================================================================
# OPTIONAL — NHTSA / EPA vehicle facts (no API key; default ON)
# =============================================================================
# Kill-switch for vPIC + NHTSA recalls (Chat still works without anchors).
# Recalls are fetched only when the vehicle market is US; EU/UK get regional copy.
# NHTSA_ENABLED=true
# VEHICLE_DATA_TIMEOUT_MS=6000
# VEHICLE_DATA_RECALL_LIMIT=3
# VEHICLE_DATA_DEBUG=1
# Optional EPA FuelEconomy.gov MPG anchors on fuel questions:
# EPA_FUELECONOMY_ENABLED=true

# =============================================================================
# OPTIONAL — owner Q&A scraper / train scripts only
# =============================================================================
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# XAI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# PROXY_LIST=http://user:pass@host:port
# EDMUNDS_API_KEY=
