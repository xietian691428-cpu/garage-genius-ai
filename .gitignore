# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local junk / archives (never deploy)
/tmp/
stripe.tar.gz
训练数据/

# typescript
*.tsbuildinfo
next-env.d.ts

# local training caches (large)
scripts/data/vcdb-cache.sqlite
scripts/data/*.sqlite
scripts/data/dtc-knowledge-seed.json
scripts/data/car-repair-qa-knowledge-seed.json
scripts/data/car-fault-knowledge-seed.json
scripts/data/car-brands50-knowledge-seed.json
scripts/data/autodata/CarRepairQA-dataset.jsonl

# owner Q&A scraper
scripts/scrape/car_qa/.venv/
scripts/scrape/car_qa/config/proxies.txt
scripts/scrape/car_qa/output/*.jsonl
!scripts/scrape/car_qa/output/.gitkeep
scripts/scrape/car_qa/.env
